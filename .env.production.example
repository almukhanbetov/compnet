# Production environment for COMPNET — VPS 89.207.254.215, /var/www/compnet.
#
# Copy to `.env` on the VPS ONLY (never commit the real file):
#   cp .env.production.example .env
#   chmod 600 .env
#
# Names only below — no real secrets. Generate a strong password with:
#   openssl rand -base64 36

# Docker Hub account that owns compnet-backend / compnet-frontend images.
# Must match the DOCKERHUB_USERNAME GitHub secret.
DOCKERHUB_USERNAME=changeme-dockerhub-username

# PostgreSQL — used only inside the compnet-network, never published to the
# host or the internet.
POSTGRES_DB=compnet_db
POSTGRES_USER=compnet_user
POSTGRES_PASSWORD=changeme-strong-random-password

# Backend: origins allowed to call the API via CORS (comma-separated, no
# spaces). Use the real production frontend origin(s).
CORS_ALLOWED_ORIGINS=http://89.207.254.215:3000

# Frontend: NEXT_PUBLIC_API_URL is NOT read here — it is baked into the
# frontend image at build time by .github/workflows/deploy.yml (build-arg),
# because Next.js inlines NEXT_PUBLIC_* variables into the client bundle at
# build time. To change it, update the NEXT_PUBLIC_API_URL repository
# variable in GitHub (Settings → Secrets and variables → Actions → Variables)
# and redeploy — editing it here has no effect.
