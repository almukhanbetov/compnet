# Production environment for COMPNET — VPS 89.207.254.215, /var/www/compnet.
#
# Copy to `.env` on the VPS ONLY (never commit the real file):
#   cp .env.production.example .env
#   chmod 600 .env
#
# Placeholders only below — no real secrets. Generate a strong password with:
#   openssl rand -base64 36

# Docker Hub account that owns compnet-backend / compnet-frontend images.
# Must match the DOCKERHUB_USERNAME GitHub secret.
DOCKERHUB_USERNAME=changeme-dockerhub-username

# PostgreSQL — used only inside the compnet-network, never published to the
# host or the internet.
POSTGRES_DB=compnet_db
POSTGRES_USER=compnet_user
POSTGRES_PASSWORD=changeme-strong-random-password

# Backend: exact browser origins of the site (comma-separated, no spaces, no
# wildcard). Both hostnames are served by Nginx, so both are listed. Chat and
# manager requests from any other origin are rejected (403).
CORS_ALLOWED_ORIGINS=https://compnet.kz,https://www.compnet.kz

# Backend: IPs/CIDRs of the reverse proxies whose X-Forwarded-For is trusted.
# REQUIRED — docker compose refuses to start without it.
# Host Nginx reaches the backend through docker-proxy, so the backend sees
# the compnet-network gateway as the peer. Read the real value on the VPS:
#   docker network inspect compnet-network --format '{{(index .IPAM.Config 0).Gateway}}'
# (172.19.0.1 at the time of writing — re-check if the network is ever recreated).
TRUSTED_PROXIES=CHANGE_ME_compnet_network_gateway

# Optional lifetimes (defaults shown). COOKIE_SECURE=true and
# COOKIE_SAMESITE=lax are fixed in docker-compose.prod.yml.
CHAT_COOKIE_TTL=2160h
MANAGER_SESSION_TTL=12h

# Frontend build-time settings are NOT read from this file. They are GitHub
# repository variables (Settings → Secrets and variables → Actions →
# Variables) passed as build args by .github/workflows/deploy.yml, because
# Next.js inlines NEXT_PUBLIC_* values into the bundle at build time:
#   NEXT_PUBLIC_API_URL             default https://compnet.kz
#   NEXT_PUBLIC_CHAT_WIDGET_ENABLED default false (anything but "true" = off)
# Changing them requires a new build (re-run the workflow).
