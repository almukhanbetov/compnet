APP_ENV=development
APP_PORT=8080
DATABASE_URL=postgres://postgres:password@postgres:5432/compnet_db?sslmode=disable
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Comma-separated IPs/CIDRs of reverse proxies whose X-Forwarded-For is
# trusted. Empty = trust none (client IP is the TCP peer).
TRUSTED_PROXIES=
# Defaults: COOKIE_SECURE=true when APP_ENV=production, false otherwise.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
CHAT_COOKIE_TTL=2160h
# Absolute lifetime of a manager (staff) session; cookie is SameSite=Strict.
MANAGER_SESSION_TTL=12h
